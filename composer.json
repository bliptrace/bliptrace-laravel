{
    "name": "bliptrace/laravel",
    "description": "Laravel SDK for Bliptrace \u2014 auto-captures exceptions and ships them to the ingest API. Thin adapter over bliptrace/php.",
    "keywords": [
        "laravel",
        "bliptrace",
        "error-tracking",
        "observability",
        "sdk"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bliptrace/php": "^2.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "livewire/flux": "^2.22",
        "livewire/livewire": "^4.4",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "spatie/laravel-settings": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Bliptrace\\Laravel\\": "src/"
        },
        "files": [
            "src/legacy-aliases.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bliptrace\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bliptrace\\Laravel\\BliptraceServiceProvider"
            ],
            "aliases": {
                "Bliptrace": "Bliptrace\\Laravel\\Facades\\Bliptrace",
                "G8Scope": "Bliptrace\\Laravel\\Facades\\Bliptrace"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../bliptrace-php",
            "options": {
                "symlink": true,
                "versions": {
                    "bliptrace/php": "2.0.0"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
